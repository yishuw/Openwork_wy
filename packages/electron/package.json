{
  "private": true,
  "name": "openwork-desktop",
  "version": "0.1.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:tsc && node build.mjs",
    "build:tsc": "tsc",
    "dev": "electron .",
    "prepack": "npm run copy:assets && npm run copy:web",
    "pack:win": "npm run build && npm run prepack && electron-builder --dir --win",
    "pack:linux": "npm run build && npm run prepack && electron-builder --dir --linux",
    "dist:win": "npm run build && npm run prepack && electron-builder --win",
    "dist:linux": "npm run build && npm run prepack && electron-builder --linux",
    "pack": "npm run pack:win",
    "dist": "npm run dist:win",
    "copy:assets": "node -e \"const{cpSync,existsSync}=require('fs');const files=[['../../app-info.json','app-info.json'],['../../app-config.json','app-config.json'],['../../config/provider-settings.json','provider-settings.json'],['../../config/mcp-settings.json','mcp-settings.json']];files.forEach(([s,d])=>{if(existsSync(s)){cpSync(s,d);console.log('copied',d)}else{console.log('skip (not found)',d)}})\"",
    "copy:web": "node -e \"const{cp}=require('fs/promises');cp('../web/dist','web-dist',{recursive:true,dereference:true}).then(()=>console.log('web-dist copied'))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "openai": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "7zip-bin": "^5.2.0",
    "app-builder-bin": "^4.0.0",
    "electron": "28.3.3",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.7",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.openwork.desktop",
    "productName": "OpenWork",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "web-dist/**/*",
      "app-info.json",
      "package.json"
    ],
    "extraResources": [
      { "from": "app-config.json", "to": "." },
      { "from": "provider-settings.json", "to": "." },
      { "from": "mcp-settings.json", "to": "." }
    ],
    "npmRebuild": false,
    "includeSubNodeModules": true,
    "asar": true,
    "icon": "build/icon",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "category": "Development",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icons"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libsecret-1-0"]
    }
  }
}
