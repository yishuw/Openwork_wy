    <mxCell id="loop-title" value="Agent 循环引擎 (核心)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="308" y="393" width="150" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="loop-content" value="AgentRuntime.chatStream() — 多轮工具调用循环（build 默认最多20轮）&lt;br&gt;1. 构建系统提示词 + 工具描述 + 上下文 (IDESnapshot) + 会话历史&lt;br&gt;2. 调用大模型 (openai SDK, Provider.chatStream)&lt;br&gt;3. 解析工具调用 → 执行工具 → 反馈结果 → 循环&lt;br&gt;4. Session 编排主 Agent + &lt;delegate&gt; 子代理委派&lt;br&gt;&lt;br&gt;事件流: chunk · thinking · tool_start · tool_end · tool_result · done · error" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1">
      <mxGeometry x="304" y="413" width="242" height="67" as="geometry"/>
    </mxCell>

    <!-- 内置工具 -->
