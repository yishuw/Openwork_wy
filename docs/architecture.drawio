    <mxCell id="tools-title" value="内置工具 (ToolRegistry · 7个)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#82b366;" vertex="1" parent="1">
      <mxGeometry x="308" y="498" width="170" height="18" as="geometry"/>
    </mxCell>
    <mxCell id="tools-content" value="file_edit — 修改现有文件（diff语义，需先read_file）&lt;br&gt;file_write — 新建 / 整文件重写&lt;br&gt;read_file — 通过 IAgentFileSystem 读取文件&lt;br&gt;list_dir — 列出目录内容&lt;br&gt;search_code — 正则搜索文件内容（跳过node_modules等）&lt;br&gt;bash — 执行Shell命令（OPENWORK_ENABLE_BASH 可关闭）&lt;br&gt;delegate — 子代理任务委托" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=8;fontColor=#555555;spacingLeft=6;" vertex="1" parent="1">
